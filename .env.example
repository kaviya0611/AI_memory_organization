# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/org_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=org_memory

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# Neo4j Graph Database (Optional - graph engine has built-in relational fallback)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# AI Provider Configuration (Optional / Reserved for Phase 2 AI Integration)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
